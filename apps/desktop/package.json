{
  "name": "@elm/desktop",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --test test/theme.test.mts",
    "build:node": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:node && npm run build:renderer",
    "build:installer": "npm run build && node scripts/build-installer.mjs",
    "dev": "npm run build && electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@elm/protocol": "*",
    "koffi": "^3.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "vite": "^6.1.0"
  }
}
