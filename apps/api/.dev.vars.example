# Copy this file to apps/api/.dev.vars for local Wrangler development.
# NEVER commit apps/api/.dev.vars or real provider secrets to Git.

GITHUB_CLIENT_ID="your-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-app-client-secret"
SESSION_HMAC_SECRET="replace-with-a-random-32-byte-hex-or-base64-secret"
