{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "elm-anydesk-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elm-anydesk-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNALING_COORDINATOR",
        "class_name": "SignalingCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SignalingCoordinator"]
    }
  ]
}
