{
  "name": "@elm/api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist && wrangler deploy --env staging --dry-run --outdir dist-staging",
    "db:migrate:local": "wrangler d1 migrations apply elm-anydesk-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply elm-anydesk-db-staging --env staging --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "rollback:staging": "wrangler rollback --env staging",
    "test": "node --experimental-strip-types --test test/phase2.test.mts"
  },
  "dependencies": {
    "@elm/protocol": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "wrangler": "^3.109.2"
  }
}
