# ============================================================================
# Elm-AnyDesk — Example Environment Variables (NO SECRETS)
# Copy to `.env` for local desktop overrides or `apps/api/.dev.vars` for Worker dev.
# Never commit real credentials or secrets to version control.
# ============================================================================

# --- 1. Desktop App Configuration (`@elm/desktop`) ---
# Point to local Wrangler dev server (`http://127.0.0.1:8787`) or deployed Cloudflare Staging Worker:
ELM_API_BASE_URL=https://elm-anydesk-api-staging.<YOUR_SUBDOMAIN>.workers.dev

# --- 2. Cloudflare Deployment Credentials (CI / CLI only — never bundled into Electron) ---
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token-workers-and-d1-edit

# --- 3. Cloudflare Worker Secrets (`wrangler secret put <NAME> --env staging`) ---
GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
SESSION_HMAC_SECRET=replace-with-at-least-32-bytes-random-hex-secret

# --- 4. Non-Secret Pilot Metadata (`apps/api/wrangler.jsonc` vars) ---
ENVIRONMENT=staging
INSTALLER_VERSION=0.5.0-phase5
INSTALLER_FILENAME=Elm-AnyDesk-Setup-0.5.0-x64.exe
INSTALLER_DOWNLOAD_URL=https://elm-anydesk-api-staging.<YOUR_SUBDOMAIN>.workers.dev/download
INSTALLER_SHA256=8e10060b69b58a97543036de78a7ef74772d66595f8409221730cac7516b7553
PILOT_STUN_ONLY=true
AUTO_UPDATE_ENABLED=false
